{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Madrid",
  "schedule": ["before 7am"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "dependencyDashboard": true,
  "dependencyDashboardApproval": true,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "platformAutomerge": false,
  "automerge": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["before 10am every weekday"],
    "vulnerabilityFixStrategy": "lowest",
    "automerge": false,
    "addLabels": ["security"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 7am on monday"],
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Majors: revisión humana y cuarentena de 14 días. Fase A sin automerge.",
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "14 days",
      "automerge": false
    },
    {
      "description": "GitHub Actions: revisión humana, sin automerge.",
      "matchManagers": ["github-actions"],
      "automerge": false
    },
    {
      "description": "MCP SDK: contrato de protocolo. Sin automerge.",
      "matchPackageNames": ["@modelcontextprotocol/sdk"],
      "groupName": "MCP SDK",
      "automerge": false,
      "addLabels": ["mcp", "mcp-sdk", "dependencies"]
    },
    {
      "description": "Imágenes Docker: pin a digest, sin automerge.",
      "matchDatasources": ["docker"],
      "pinDigests": true,
      "automerge": false
    }
  ]
}

      "readOnlyHint": false,
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "attachments": {
          "items": {
            "properties": {
              "content_base64": {
                "type": "string",
              },
              "content_type": {
                "type": "string",
              },
              "filename": {
                "type": "string",
              },
            },
            "required": [

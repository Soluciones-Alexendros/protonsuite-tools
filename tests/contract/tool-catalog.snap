          "description": "ISO date — only messages on/after this date",
          "type": "string",
        },
        "to_address": {
          "description": "Restrict to messages to this address",
          "type": "string",
        },
        "unseen_only": {
          "default": false,
          "description": "Only return unread messages",
          "type": "boolean",
        },
      },
      "type": "object",

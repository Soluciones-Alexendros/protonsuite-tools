              "content_base64",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "bcc": {
          "items": {
            "format": "email",
            "pattern": "^(?!\.)(?!.*\.\.)([A-Za-z0-9_'+\-\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\-]*\.)+[A-Za-z]{2,}$",
            "type": "string",
          },
          "type": "array",
        },
        "cc": {
          "items": {
            "format": "email",
            "pattern": "^(?!\.)(?!.*\.\.)([A-Za-z0-9_'+\-\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\-]*\.)+[A-Za-z]{2,}$",
            "type": "string",
          },
          "type": "array",
        },
        "html": {
          "type": "string",
        },
        "reply_to": {
          "format": "email",
          "pattern": "^(?!\.)(?!.*\.\.)([A-Za-z0-9_'+\-\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\-]*\.)+[A-Za-z]{2,}$",
          "type": "string",
        },
        "subject": {
          "minLength": 1,
          "type": "string",
        },
        "text": {
          "type": "string",
        },
        "to": {
          "description": "Recipient addresses",
          "items": {
            "format": "email",
            "pattern": "^(?!\.)(?!.*\.\.)([A-Za-z0-9_'+\-\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\-]*\.)+[A-Za-z]{2,}$",
            "type": "string",
          },
          "minItems": 1,
          "type": "array",
        },
      },
      "required": [
        "to",
        "subject",
      ],
      "type": "object",
    },
    "name": "proton_send_email",

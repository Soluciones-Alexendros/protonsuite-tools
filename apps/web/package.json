{
  "name": "@alexendros/protonsuite-web",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:contrast": "node scripts/check-contrast.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-tokens.mjs && node scripts/check-contrast.mjs && node scripts/check-ui.mjs && tsc --noEmit && vite build",
    "dev": "node scripts/build-tokens.mjs && vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=22"
  }
}
